# Comma-separated SinoTrack identifiers accepted by the TCP listener.
HERRING_DEVICE_IDS=1234567890

# Required when HERRING_ENV=production. Use a random, one-time setup secret.
HERRING_SETUP_TOKEN=replace-with-a-long-random-value

# Local overrides; production supplies these values in the image/Ansible role.
HERRING_DATABASE_PATH=herring.db
HERRING_HTTP_ADDR=:8080
HERRING_TRACKER_ADDR=:8090
